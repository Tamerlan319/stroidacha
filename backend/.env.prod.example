DEBUG=False
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE

DB_NAME=brusoteka
DB_USER=brusoteka_user
DB_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
DB_HOST=db
DB_PORT=5432

ALLOWED_HOSTS=brusodel.ru,www.brusodel.ru,194.67.74.172,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://brusodel.ru,https://www.brusodel.ru
CSRF_TRUSTED_ORIGINS=https://brusodel.ru,https://www.brusodel.ru

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

GUNICORN_WORKERS=2

# По умолчанию — console.EmailBackend: письма о заявках только пишутся в лог
# контейнера backend, наружу не уходят. Чтобы реально получать заявки на
# почту, переключите на smtp.EmailBackend и заполните EMAIL_HOST* ниже — см.
# DEPLOYMENT.md > "Email-уведомления о заявках".
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=brusodel@yandex.ru
# Пароль приложения из Яндекс ID (Пароли и приложения), НЕ пароль от
# основного аккаунта — обычный пароль Яндекс для внешнего SMTP не примет.
# EMAIL_HOST_PASSWORD=CHANGE_ME_YANDEX_APP_PASSWORD

# С smtp.EmailBackend через Яндекс DEFAULT_FROM_EMAIL должен совпадать с
# EMAIL_HOST_USER (иначе Яндекс отклонит письмо как подмену отправителя).
DEFAULT_FROM_EMAIL=no-reply@brusodel.ru

# Куда слать уведомления о новых заявках (leads.services.notify_managers_about_lead).
# Через запятую можно указать несколько адресов.
LEAD_NOTIFICATION_EMAILS=

# Лимит на приём заявок с одного IP (см. leads.views.LeadCreateAPIView).
# Формат — как в DRF throttle rates: "10/hour", "3/minute" и т.п.
LEAD_THROTTLE_RATE=10/hour

# Срок хранения ПДн заявки в месяцах (см. leads.anonymize_old_leads).
LEAD_RETENTION_MONTHS=24

# Шифрование резервных копий БД (см. scripts/deploy.sh и DEPLOYMENT.md >
# "Резервные копии"). Без этой переменной бэкап пишется НЕ зашифрованным —
# только для первого запуска, до настройки ключа.
# BACKUP_GPG_RECIPIENT=backup@brusodel.ru

# Опциональная копия бэкапа во внешнее хранилище через rclone (см.
# DEPLOYMENT.md). Без этой переменной шаг просто пропускается.
# BACKUP_REMOTE_RCLONE_TARGET=yandex-s3:brusoteka-backups/
