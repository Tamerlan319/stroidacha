brusodel.ru, www.brusodel.ru {
	encode zstd gzip

	@www host www.brusodel.ru
	redir @www https://brusodel.ru{uri} permanent

	request_body {
		max_size 80MB
	}

	# Источники подобраны под реально используемые скрипты/встройки:
	# Яндекс Метрика (components/YandexMetrika.tsx), встроенная карта на
	# главной и в контактах (yandex.ru/map-widget), JSON-LD (components/
	# JsonLd.tsx). 'unsafe-inline' в script-src — вынужденный компромисс:
	# без него ломается не только Метрика и JSON-LD, но и собственный
	# инлайн-скрипт гидратации Next.js App Router (__next_f). Без nonce-
	# инфраструктуры в Next.js (отдельная задача) строгий CSP без
	# unsafe-inline положит сайт. CSP всё равно полезен: он не даёт
	# подгрузить скрипт/фрейм/XHR с произвольного стороннего хоста, если
	# где-то удастся внедрить <script src="https://evil.example/x.js">.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.yandex.ru https://*.yandex.net; frame-src https://yandex.ru https://*.yandex.ru; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	# Статика Django (в основном админка) — имена файлов не хэшируются по
	# содержимому, поэтому долгий immutable-кэш небезопасен: используем
	# умеренный срок с обязательной ревалидацией.
	handle_path /static/* {
		root * /var/www/static
		header Cache-Control "public, max-age=604800, must-revalidate"
		file_server
	}

	# Медиатека Django (фото проектов, портфолио, SEO-страниц). При повторной
	# загрузке файла с тем же именем Django сам генерирует новое имя, поэтому
	# путь у уже опубликованного файла практически не переиспользуется —
	# длинный кэш здесь безопасен и даёт основной выигрыш: карточка проекта
	# может отдавать по 5-10 фотографий, и раньше все они уходили без единого
	# заголовка Cache-Control.
	handle_path /media/* {
		root * /var/www/media
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# Статические файлы из frontend/public (баннеры, логотипы, иконки).
	# В отличие от /media/*, эти файлы иногда переиздаются под тем же путём
	# (см. историю правок home-hero.jpg) — поэтому не ставим сюда год с
	# immutable, как для хэшированных чанков Next.js, а держим короткий кэш
	# с быстрым фоновым обновлением.
	@publicAssets path /images/* /brand/* /favicon.ico /apple-icon.png /icon.svg /file.svg
	handle @publicAssets {
		header Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
		reverse_proxy frontend:3000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Путь читается из ADMIN_URL_PATH (backend/.env.prod) тем же именем, что
	# и в Django settings.py — сканеры ботов проверяют буквально "/admin/"
	# независимо от пароля, поэтому сам путь не хардкодим здесь так же, как
	# не хардкодим его в urls.py. Без переменной (например, локально) —
	# откатывается на "admin/".
	handle /{$ADMIN_URL_PATH:admin/}* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

brusoteka.ru, www.brusoteka.ru {
	redir https://brusodel.ru{uri} permanent
}
