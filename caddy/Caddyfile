brusodel.ru, www.brusodel.ru {
	encode zstd gzip

	@www host www.brusodel.ru
	redir @www https://brusodel.ru{uri} permanent

	request_body {
		max_size 80MB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# X-Frame-Options убран намеренно (не забыт): он умеет только
		# DENY/SAMEORIGIN, а плеер Вебвизора и карта кликов грузят сайт в
		# iframe с webvisor.com и доменов интерфейса Метрики — под них нужно
		# точечное разрешение, а не полный запрет или "тот же домен". CSP
		# frame-ancestors ниже умеет перечислить конкретные источники и по
		# спеке имеет приоритет над X-Frame-Options во всех современных
		# браузерах, так что держать оба смысла не имеет — только путаница.
	}

	# Источники подобраны под реально используемые скрипты/встройки:
	# Яндекс Метрика (components/YandexMetrika.tsx), встроенная карта на
	# главной и в контактах (yandex.ru/map-widget), JSON-LD (components/
	# JsonLd.tsx), Яндекс SmartCaptcha (components/LeadForm.tsx — виджет
	# грузится с smartcaptcha.yandexcloud.net, это отдельный от *.yandex.ru
	# домен, поэтому нужен собственный *.yandexcloud.net во всех трёх
	# директивах: сам скрипт, его обращения к серверу капчи и виджет
	# challenge'а во фрейме). 'unsafe-inline' в script-src — вынужденный
	# компромисс: без него ломается не только Метрика и JSON-LD, но и
	# собственный инлайн-скрипт гидратации Next.js App Router (__next_f).
	# Без nonce-инфраструктуры в Next.js (отдельная задача) строгий CSP без
	# unsafe-inline положит сайт. CSP всё равно полезен: он не даёт
	# подгрузить скрипт/фрейм/XHR с произвольного стороннего хоста, если
	# где-то удастся внедрить <script src="https://evil.example/x.js">.
	#
	# Метрика — дословно "Общий список адресов" (https:// и wss://) и
	# "Адреса для frame-ancestors" из yandex.ru/support/metrica/code/
	# install-counter-csp.html. Раньше здесь был один mc.yandex.ru: без
	# img-src, blob: в child-src/frame-src и доменов интерфейса Метрики в
	# frame-ancestors часть отправок счётчика блокировалась браузером, а
	# карта кликов и Вебвизор не могли открыть сайт во фрейме. Не урезать
	# список "до нужного": сам Яндекс предупреждает, что в примерах из
	# инструкции прописаны не все адреса. webvisor.com с поддоменами —
	# из справки по карте кликов (раздел "Показ данных в iframe"), и именно
	# http://, а не https://: webvisor.com работает по голому http (https
	# оттуда редиректит на http), а источник http:// в CSP по спеке
	# покрывает и https, наоборот — нет.
	#
	# Счётчик внутри такого фрейма загружается без cookie-согласия — см.
	# isInsideMetrikaFrame в frontend/app/lib/metrika.ts.
	#
	# Отдельный header с match по text/html — не случайность: CSP действует
	# только на документы, а с полным списком Метрики заголовок весит ~4 КБ,
	# отправлять его с каждым JS-чанком и фото проекта незачем.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org https://yastatic.net https://*.yandexcloud.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org https://yastatic.net; font-src 'self'; connect-src 'self' https://*.yandex.ru https://*.yandex.net https://*.yandexcloud.net https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org https://yastatic.net wss://mc.yandex.ru wss://mc.yandex.az wss://mc.yandex.by wss://mc.yandex.co.il wss://mc.yandex.com wss://mc.yandex.com.am wss://mc.yandex.com.ge wss://mc.yandex.com.tr wss://mc.yandex.ee wss://mc.yandex.fr wss://mc.yandex.kg wss://mc.yandex.kz wss://mc.yandex.lt wss://mc.yandex.lv wss://mc.yandex.md wss://mc.yandex.tj wss://mc.yandex.tm wss://mc.yandex.uz wss://mc.webvisor.com wss://mc.webvisor.org; child-src 'self' blob: https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org https://yastatic.net https://*.yandexcloud.net; frame-src blob: https://yandex.ru https://*.yandex.ru https://*.yandexcloud.net https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org https://yastatic.net; frame-ancestors 'self' http://webvisor.com http://*.webvisor.com https://metrika.yandex.ru https://analytics.yandex.by https://analytics.yandex.com https://analytics.yandex.com.tr https://analytics.yandex.kz https://analytics.yandex.ru https://metr.yandex.by https://metr.yandex.com https://metr.yandex.com.tr https://metr.yandex.kz https://metr.yandex.ru https://metrica.ya.ru https://metrica.yandex https://metrica.yandex.by https://metrica.yandex.com https://metrica.yandex.com.tr https://metrica.yandex.kz https://metrica.yandex.ru https://metrika.ya.ru https://metrika.yandex https://metrika.yandex.by https://metrika.yandex.com https://metrika.yandex.com.tr https://metrika.yandex.kz https://metrika.yandex.uz; base-uri 'self'; form-action 'self'; object-src 'none'"
		match {
			header Content-Type text/html*
		}
	}

	# Статика Django (в основном админка) — имена файлов не хэшируются по
	# содержимому, поэтому долгий immutable-кэш небезопасен: используем
	# умеренный срок с обязательной ревалидацией.
	handle_path /static/* {
		root * /var/www/static
		header Cache-Control "public, max-age=604800, must-revalidate"
		file_server
	}

	# Медиатека Django (фото проектов, портфолио, SEO-страниц). При повторной
	# загрузке файла с тем же именем Django сам генерирует новое имя, поэтому
	# путь у уже опубликованного файла практически не переиспользуется —
	# длинный кэш здесь безопасен и даёт основной выигрыш: карточка проекта
	# может отдавать по 5-10 фотографий, и раньше все они уходили без единого
	# заголовка Cache-Control.
	handle_path /media/* {
		root * /var/www/media
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# Статические файлы из frontend/public (баннеры, логотипы, иконки).
	# В отличие от /media/*, эти файлы иногда переиздаются под тем же путём
	# (см. историю правок home-hero.jpg) — поэтому не ставим сюда год с
	# immutable, как для хэшированных чанков Next.js, а держим короткий кэш
	# с быстрым фоновым обновлением.
	@publicAssets path /images/* /brand/* /favicon.ico /apple-icon.png /icon.svg /file.svg
	handle @publicAssets {
		header Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
		reverse_proxy frontend:3000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Путь читается из ADMIN_URL_PATH (backend/.env.prod) тем же именем, что
	# и в Django settings.py — сканеры ботов проверяют буквально "/admin/"
	# независимо от пароля, поэтому сам путь не хардкодим здесь так же, как
	# не хардкодим его в urls.py. Без переменной (например, локально) —
	# откатывается на "admin/".
	handle /{$ADMIN_URL_PATH:admin/}* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

brusoteka.ru, www.brusoteka.ru {
	redir https://brusodel.ru{uri} permanent
}
